# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets never get committed, but the template must be,
# otherwise a teammate cloning the repo has no idea what to set.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local tooling (agent skills, skill lockfile, personal settings)
# — not part of the app, kept local rather than distributed with the repo
/.agents
/skills-lock.json
/.claude
.env*.local
