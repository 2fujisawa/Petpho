# Copy to .env.local and fill in. Never commit the filled-in file — .env* is
# gitignored on purpose. In production these live in
# Vercel → Settings → Environment Variables.
#
# Check your setup any time at /api/status while signed in; the studio also
# shows a banner on load if any of these are missing or rejected.

# Image + video generation. Starts with "r8_".
# Get one: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Permanent storage for results — OPTIONAL, and normally left blank.
# On Vercel this authenticates via OIDC: connect the Blob store to the project
# (Vercel → Storage → your store → Projects → Connect to Project, ticking every
# environment you need), then run `vercel env pull`. That provides BLOB_STORE_ID
# and VERCEL_OIDC_TOKEN, which rotate automatically — no static secret to leak.
# Only set a static token when running off Vercel, e.g. in CI. Starts with
# "vercel_blob_rw_". Without either, results fall back to Replicate URLs that
# expire in ~1 hour.
BLOB_READ_WRITE_TOKEN=

# Shared sign-in password for the studio. Pick a strong one and use the same
# value in every environment.
ADMIN_PASSWORD = 

# Optional. Comma-separated LAN hosts allowed to reach the dev server, for
# testing on a phone or another machine, e.g. "192.168.1.20".
DEV_ALLOWED_ORIGINS=
